{
  "name": "kilorito-remote",
  "productName": "Mirra",
  "version": "0.2.0",
  "description": "Controlá tu PC desde el celular por WiFi (WebRTC)",
  "author": "kilorito",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:client && electron-vite dev",
    "build:client": "vite build --config client/vite.config.ts",
    "build": "npm run build:client && electron-vite build --mode e2e",
    "build:prod": "npm run build:client && electron-vite build --mode production",
    "dist": "npm run build:prod && node scripts/assert-no-test-mode.mjs && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.client.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --config playwright.config.ts",
    "test:android": "npm run build && node scripts/android-run.mjs",
    "android:setup": "node scripts/android-setup.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:e2e:real": "npm run build && node scripts/run-real-e2e.mjs"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24",
    "@peculiar/asn1-schema": "2.10.0",
    "@peculiar/asn1-x509": "2.10.0",
    "@peculiar/x509": "2.1.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "ws": "8.22.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
